@model IEnumerable<QLNhaTroWeb.Models.PhieuThu>
@{ ViewData["Title"] = "Quản lý Hóa Đơn"; }

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Danh sách Hóa Đơn</h5>
                <p class="text-muted small mb-0">Theo dõi tình trạng thanh toán và lập hóa đơn mới.</p>
            </div>
            <a asp-action="Create" class="btn btn-success px-4 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Lập Hóa Đơn Mới
            </a>
        </div>

        @if (TempData["Success"] != null) { <div class="alert alert-success border-0 shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã PT</th>
                        <th class="py-3">Phòng</th>
                        <th class="py-3">Ngày Lập</th>
                        <th class="py-3">Tổng Tiền</th>
                        <th class="py-3">Trạng Thái</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có hóa đơn nào.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            // Tra cứu thông tin khách thuê phòng
                            var khachHangs = ViewBag.KhachHangs as List<QLNhaTroWeb.Models.ThongTinKhach>;
                            var khach = khachHangs?.FirstOrDefault(k => k.MaPhong == item.MaPhong);
                            var tenKhach = khach != null ? $"{khach.Ho} {khach.Ten}" : "Khách vãng lai";

                            <tr>
                                <td class="fw-semibold text-primary">#@item.MaPT</td>
                                <td class="fw-medium">
                                    <i class="bi bi-door-closed text-muted me-1"></i>@item.Phong?.TenPhong
                                    <br/><span class="text-muted small">@tenKhach</span>
                                </td>
                                <td>@item.NgayLap.ToString("dd/MM/yyyy")</td>
                                <td class="text-danger fw-bold">@item.TongTien?.ToString("N0") VNĐ</td>
                                <td>
                                    @if (item.TrangThai == "Đã thu") { <span class="badge bg-success bg-opacity-10 text-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>@item.TrangThai</span> }
                                    else { <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1"><i class="bi bi-clock me-1"></i>@item.TrangThai</span> }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Print" asp-route-id="@item.MaPT" target="_blank" class="btn btn-sm btn-outline-info" title="In hóa đơn" style="border-radius: 6px;"><i class="bi bi-printer"></i> In</a>

                                        @if (item.TrangThai != "Đã thu")
                                        {
                                            <!-- Nút mở Modal xác nhận -->
                                            <button type="button" class="btn btn-sm btn-primary" style="border-radius: 6px;" 
                                                    data-bs-toggle="modal" data-bs-target="#confirmModal_@item.MaPT">
                                                <i class="bi bi-cash-coin"></i> Thu Tiền
                                            </button>

                                            <!-- Modal Xác Nhận Thanh Toán (Mở rộng modal-lg) -->
                                            <div class="modal fade" id="confirmModal_@item.MaPT" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title"><i class="bi bi-receipt me-2"></i>Chi tiết Hóa Đơn #@item.MaPT</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            
                                                            <!-- Thông tin Khách và Phòng -->
                                                            <div class="row mb-4">
                                                                <div class="col-sm-6">
                                                                    <p class="mb-1 text-muted small">Khách hàng:</p>
                                                                    <h6 class="fw-bold">@tenKhach</h6>
                                                                </div>
                                                                <div class="col-sm-6 text-sm-end">
                                                                    <p class="mb-1 text-muted small">Phòng / Loại phòng:</p>
                                                                    <h6 class="fw-bold">@item.Phong?.TenPhong (@item.Phong?.LoaiPhong?.TenLoaiPhong)</h6>
                                                                </div>
                                                            </div>

                                                            <!-- Bảng chi tiết dịch vụ -->
                                                            <table class="table table-bordered table-striped mb-4">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>Khoản mục</th>
                                                                        <th class="text-center">Số lượng / Chỉ số</th>
                                                                        <th class="text-end">Thành tiền (VNĐ)</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>Tiền nhà</td>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-end fw-semibold">@item.TienNha?.ToString("N0")</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tiền điện</td>
                                                                        <td class="text-center">@item.SkDien ký</td>
                                                                        <td class="text-end fw-semibold">@item.TienDien?.ToString("N0")</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Tiền nước</td>
                                                                        <td class="text-center">@item.SkNuoc khối</td>
                                                                        <td class="text-end fw-semibold">@item.TienNuoc?.ToString("N0")</td>
                                                                    </tr>
                                                                </tbody>
                                                                <tfoot>
                                                                    <tr class="bg-light">
                                                                        <td colspan="2" class="text-end fw-bold fs-6">TỔNG CỘNG:</td>
                                                                        <td class="text-end text-danger fw-bold fs-5">@item.TongTien?.ToString("N0") VNĐ</td>
                                                                    </tr>
                                                                </tfoot>
                                                            </table>

                                                            <div class="alert alert-warning mb-0 d-flex align-items-center">
                                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                                <div>
                                                                    <strong>Xác nhận thanh toán:</strong> Bạn có chắc chắn khách hàng đã thanh toán đủ số tiền trên không?
                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="modal-footer border-0 bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                                                            <form asp-action="ThanhToan" asp-route-id="@item.MaPT" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Xác nhận đã thu</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>