@model IEnumerable<QLNhaTroWeb.Models.YeuCauThuePhong>
@{ ViewData["Title"] = "Duyệt Yêu Cầu Đặt Phòng"; }

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0 text-dark">Yêu Cầu Đặt Phòng Từ Khách Hàng</h5>
        </div>

        @if (TempData["Success"] != null) { <div class="alert alert-success border-0 shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div> }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã YC</th>
                        <th class="py-3">Khách Hàng</th>
                        <th class="py-3">Phòng Yêu Cầu</th>
                        <th class="py-3">Ngày ĐK</th>
                        <th class="py-3">Trạng Thái</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">#@item.MaYeuCau</td>
                            <td class="fw-medium">@item.KhachTro?.Ho @item.KhachTro?.Ten <br/><span class="text-muted small">@item.MaKhachTro</span></td>
                            <td class="fw-bold text-success">@item.Phong?.TenPhong</td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Chờ duyệt") { <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Chờ duyệt</span> }
                                else if (item.TrangThai == "Đã duyệt") { <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span> }
                                else { <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@item.TrangThai</span> }
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "Chờ duyệt")
                                {
                                    <form asp-action="Duyet" asp-route-id="@item.MaYeuCau" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Duyệt và xếp phòng cho khách?');"><i class="bi bi-check-lg"></i> Duyệt</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal_@item.MaYeuCau"><i class="bi bi-x-lg"></i> Từ chối</button>

                                    <!-- Modal Từ Chối -->
                                    <div class="modal fade" id="rejectModal_@item.MaYeuCau" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title">Từ chối yêu cầu #@item.MaYeuCau</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="TuChoi" asp-route-id="@item.MaYeuCau" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-body text-start">
                                                        <label class="form-label small text-muted">Lý do từ chối:</label>
                                                        <textarea name="lyDo" class="form-control" rows="3" required placeholder="Nhập lý do gửi cho khách..."></textarea>
                                                    </div>
                                                    <div class="modal-footer border-0">
                                                        <button type="submit" class="btn btn-danger w-100">Xác nhận Từ chối</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>