@model IEnumerable<QLNhaTroWeb.Models.Phong>
@{ ViewData["Title"] = "Quản lý Phòng"; }

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Danh sách Phòng</h5>
                <p class="text-muted small mb-0">Quản lý trạng thái và thông tin các phòng trong khu trọ.</p>
            </div>
            <a asp-action="Create" class="btn btn-success px-4 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Thêm Phòng Mới
            </a>
        </div>

        <!-- Thông báo -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã Phòng</th>
                        <th class="py-3">Tên Phòng</th>
                        <th class="py-3">Dãy</th>
                        <th class="py-3">Khu Vực</th>
                        <th class="py-3">Loại Phòng</th>
                        <th class="py-3">Trạng Thái</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Chưa có phòng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">@item.MaPhong</td>
                                <td class="fw-medium">@item.TenPhong</td>
                                <td>@item.Day</td>
                                <td>@item.KhuVuc?.TenKhuVuc</td>
                                <td>@item.LoaiPhong?.TenLoaiPhong</td>
                                <td>
                                    @if (item.TrangThai == "Còn trống")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1"><i class="bi bi-door-open me-1"></i>@item.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1"><i class="bi bi-person-fill me-1"></i>@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.MaPhong" class="btn btn-sm btn-outline-primary" title="Sửa thông tin" style="border-radius: 6px;">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.MaPhong" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phòng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa phòng" style="border-radius: 6px;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
    </div>
</div>