@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<!-- 4 Thẻ thống kê -->
<div class="row g-4 mb-4">
    <!-- Tổng số phòng -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #2563EB !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tổng số phòng</p>
                        <h2 class="mb-0 fw-bold text-dark display-6">@ViewBag.TotalRooms</h2>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(37, 99, 235, 0.1); color: #2563EB;">
                        <i class="bi bi-door-open-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Phòng đang quản lý</div>
            </div>
        </div>
    </div>

    <!-- Phòng đang thuê -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #16A34A !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Phòng đang thuê</p>
                        <h2 class="mb-0 fw-bold text-dark display-6">@ViewBag.OccupiedRooms</h2>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(22, 163, 74, 0.1); color: #16A34A;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Có người ở</div>
            </div>
        </div>
    </div>

    <!-- Phòng còn trống -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #F59E0B !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Phòng còn trống</p>
                        <h2 class="mb-0 fw-bold text-dark display-6">@ViewBag.EmptyRooms</h2>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(245, 158, 11, 0.1); color: #F59E0B;">
                        <i class="bi bi-door-closed-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Sẵn sàng cho thuê</div>
            </div>
        </div>
    </div>

    <!-- Hóa đơn chưa thu -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #EF4444 !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Hóa đơn chưa thu</p>
                        <h2 class="mb-0 fw-bold text-dark display-6">@ViewBag.UnpaidInvoices</h2>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(239, 68, 68, 0.1); color: #EF4444;">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Cần xử lý ngay</div>
            </div>
        </div>
    </div>
</div>

<!-- Khu vực Doanh thu & Khách hàng -->
<div class="row g-4 mb-4">
    <!-- Doanh thu -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0">Doanh thu tháng @DateTime.Now.Month / @DateTime.Now.Year</h5>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Đã thu</span>
                </div>
                
                <h1 class="text-success fw-bold display-4 mb-2">
                    @(((long)ViewBag.MonthlyRevenue).ToString("N0")) <span class="fs-4">VNĐ</span>
                </h1>
                
                <div class="d-flex align-items-center mt-3 text-muted">
                    <i class="bi bi-info-circle me-2"></i>
                    <span class="small">Chỉ tính các hóa đơn đã được xác nhận thanh toán trong tháng này.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tổng số khách -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100 text-center" style="border-radius: 12px;">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
                    <i class="bi bi-person-badge fs-2"></i>
                </div>
                <p class="text-muted fw-semibold mb-1 text-uppercase" style="font-size: 0.85rem;">Tổng số khách</p>
                <h1 class="fw-bold text-dark display-5 mb-2">@ViewBag.TotalCustomers</h1>
                <span class="text-muted small">Khách đang lưu trú</span>
            </div>
        </div>
    </div>
</div>

<!-- Khung hướng dẫn / Chào mừng -->
<div class="card border-0 shadow-sm" style="border-radius: 12px; background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);">
    <div class="card-body p-4">
        <div class="d-flex align-items-start">
            <div class="me-4 d-none d-sm-block">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-rocket-takeoff fs-3"></i>
                </div>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-2">Chào mừng đến với Hệ thống Quản lý Nhà trọ</h5>
                <p class="text-muted mb-3">Sử dụng thanh menu bên trái để quản lý phòng, khách thuê và hóa đơn. Hãy duyệt các yêu cầu đặt phòng mới để không bỏ lỡ khách hàng.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/DuyetDangKy/Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">Duyệt đơn đăng ký</a>
                    <a href="/PhieuThu/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Lập hóa đơn mới</a>
                </div>
            </div>
        </div>
    </div>
</div>