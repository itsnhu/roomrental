@model IEnumerable<QLNhaTroWeb.Models.ThongTinDangKyPhong>
@{ ViewData["Title"] = "Duyệt Đơn Đăng Ký"; }

<div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4" style="border-radius: 12px;">
    <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
    <div>
        <h6 class="fw-bold mb-1">Hướng dẫn duyệt đơn</h6>
        <p class="mb-0 small">Hệ thống sẽ tự động tạo tài khoản (Mật khẩu: 123), hồ sơ khách hàng và hợp đồng thuê nếu bạn chọn "Duyệt" và đơn có đăng ký phòng cụ thể.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã Đơn</th>
                        <th class="py-3">Khách Hàng</th>
                        <th class="py-3">CMND</th>
                        <th class="py-3">Nguyện Vọng</th>
                        <th class="py-3">Phòng Đã Chọn</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Không có đơn đăng ký nào đang chờ duyệt.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">#@item.Id</td>
                                <td class="fw-medium">@item.Ho @item.Ten</td>
                                <td>@item.CMND</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary mb-1">@item.KhuVuc?.TenKhuVuc</span><br/>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">@item.LoaiPhong?.TenLoaiPhong</span>
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(item.MaPhong)) {
                                        <span class="badge bg-success"><i class="bi bi-door-closed me-1"></i>@item.Phong?.TenPhong</span>
                                    } else {
                                        <span class="text-muted fst-italic small">Tự xếp sau</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="Duyet" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Duyệt đơn đăng ký này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success px-3" style="border-radius: 6px;">
                                            <i class="bi bi-check-lg me-1"></i> Duyệt
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>