@model IEnumerable<QLNhaTroWeb.Models.ThongTinThuePhong>
@{ ViewData["Title"] = "Quản lý Hợp Đồng"; }

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Danh sách Hợp Đồng Thuê</h5>
                <p class="text-muted small mb-0">Quản lý các hợp đồng thuê phòng hiện tại của khách hàng.</p>
            </div>
            <a asp-action="Create" class="btn btn-success px-4 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Lập Hợp Đồng Mới
            </a>
        </div>

        <!-- Thông báo -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã HĐ</th>
                        <th class="py-3">Khách Hàng</th>
                        <th class="py-3">Phòng Thuê</th>
                        <th class="py-3">Ngày Thuê</th>
                        <th class="py-3">Tiền Đặt Cọc</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Chưa có hợp đồng thuê nào được lập.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">@item.MaHD</td>
                                <td>
                                    <div class="fw-medium">@item.ThongTinKhach?.Ho @item.ThongTinKhach?.Ten</div>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary mt-1">@item.MaKhachTro</span>
                                </td>
                                <td>
                                    <div class="fw-medium text-success"><i class="bi bi-door-closed me-1"></i>@item.Phong?.TenPhong</div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary mt-1">@item.MaPhong</span>
                                </td>
                                <td class="text-danger fw-bold">@(item.TienDatCoc?.ToString("N0") ?? "0") VNĐ</td>
                                <td class="text-danger fw-bold">@(item.TienDatCoc?.ToString("N0") ?? "0") VNĐ</td>
                                <td class="text-center">
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy hợp đồng này? Phòng sẽ trả về trạng thái Còn Trống.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maHD" value="@item.MaHD" />
                                        <input type="hidden" name="maKhachTro" value="@item.MaKhachTro" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy hợp đồng" style="border-radius: 6px;">
                                            <i class="bi bi-x-circle me-1"></i> Hủy Hợp Đồng
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
    </div>
</div>