@model IEnumerable<QLNhaTroWeb.Models.ThongTinKhach>
@{ ViewData["Title"] = "Quản lý Khách Thuê"; }

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Danh sách Khách Thuê</h5>
                <p class="text-muted small mb-0">Quản lý thông tin và phòng đang thuê của khách hàng.</p>
            </div>
            <a asp-action="Create" class="btn btn-success px-4 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Thêm Khách Mới
            </a>
        </div>

        @if (TempData["Success"] != null) { <div class="alert alert-success border-0 shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div> }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3">Mã Khách</th>
                        <th class="py-3">Họ và Tên</th>
                        <th class="py-3">Giới Tính</th>
                        <th class="py-3">CMND/CCCD</th>
                        <th class="py-3">Quê Quán</th>
                        <th class="py-3">Mã Phòng</th>
                        <th class="py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có khách thuê nào.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">@item.MaKhachTro</td>
                                <td class="fw-medium">@item.Ho @item.Ten</td>
                                <!-- ĐÃ SỬA GIỚI TÍNH THÀNH TEXT BÌNH THƯỜNG -->
                                <td>@item.GioiTinh</td>
                                <td>@item.CMND</td>
                                <td>@item.QueQuan</td>
                                <td>
                                    @if(!string.IsNullOrEmpty(item.MaPhong))
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                                            <i class="bi bi-door-closed me-1"></i>@item.MaPhong
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Chưa xếp phòng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.MaKhachTro" class="btn btn-sm btn-outline-primary" title="Sửa" style="border-radius: 6px;"><i class="bi bi-pencil-square"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.MaKhachTro" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa" style="border-radius: 6px;"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>